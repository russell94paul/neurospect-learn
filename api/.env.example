# Database
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/neurospect_learn
DATABASE_URL_SYNC=postgresql+psycopg2://user:pass@host:5432/neurospect_learn

# JWT
JWT_SECRET=changeme
JWT_EXPIRE_MINUTES=43200

# Discord OAuth (reuse the same Discord application; register a new redirect URI for the learn app)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Who may hold an account — JSON list of Discord user IDs (Phase B3).
# The Discord app is Public, so on a reachable URL anyone who finds the host
# could otherwise mint themselves an account. See app/auth/allowlist.py.
#   unset + DEBUG=true   -> everyone  (localhost, the test suite, debug tokens)
#   unset + DEBUG=false  -> NOBODY    (deliberately fail-closed; every login 403s)
#   set                  -> exactly these IDs, in either mode
# ALLOWED_DISCORD_IDS=["123456789012345678"]

# CORS — JSON list of allowed origins. Localhost is right for dev; a deployment
# MUST override it with its real frontend origin, e.g.
#   CORS_ORIGINS=["https://neurospect-learn.pages.dev"]
CORS_ORIGINS=["http://localhost:5173"]

# Debug (never true in prod) — enables POST /auth/debug/token, and is what makes
# an unset ALLOWED_DISCORD_IDS fail closed rather than open.
DEBUG=false

# Wiki content root — neurospect-wiki checkout the content ingest reads (READ-ONLY).
# Defaults to the sibling repo (../neurospect-wiki); override if it lives elsewhere.
# WIKI_CONTENT_ROOT=C:\Users\PaulRussell\repos\neurospect-wiki

# ---------------------------------------------------------------------------
# Evidence storage (Phase E2 — the learning-enforcement evidence layer)
# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible). Leave R2_ENDPOINT_URL EMPTY for local dev: the
# storage service then uses the local filesystem backend and localhost needs no
# bucket at all. Setting it is a config flip, not a code change.
#
# ⚠ ON A DEPLOYED INSTANCE R2 IS NOT OPTIONAL (Phase B3). Render's container
# filesystem is ephemeral, so the local backend loses every stored chart on each
# deploy WHILE the evidence_assets rows survive — leaving reps derived from
# evidence that no longer exists, with nothing raising an error.
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=neurospect-learn-evidence

# Where the local backend writes evidence blobs. Defaults to <repo>/.evidence-store
# (gitignored). Only used when R2_ENDPOINT_URL is empty.
# EVIDENCE_LOCAL_ROOT=C:\Users\PaulRussell\repos\neurospect-learn\.evidence-store

# Deterministic-tier upload bounds (bytes). The deterministic tier is the ONLY
# tier that blocks an upload; these are its size limits.
# EVIDENCE_MAX_BYTES=12582912
# EVIDENCE_MIN_BYTES=512

# ---------------------------------------------------------------------------
# AI vision second reader (Phase E4 — tier 3, ADVISORY)
# ---------------------------------------------------------------------------
# OFF by default: the app runs with no LLM dependency and the upload path is
# byte-for-byte identical either way. Turn it on to get an advisory read beside
# your own self-check. It NEVER blocks an upload, never changes a rep count, and
# never writes confidence or ladder_stage.
# AI_GRADING_ENABLED=true

# There is deliberately NO api-key setting here. The Anthropic SDK resolves the
# credential itself, in this order: ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN ->
# an `ant auth login` profile on disk. A second copy in .env could only drift
# from it. Set ANTHROPIC_API_KEY in the environment, or run `ant auth login`.

# Which model reads. Sonnet 5 per design §2 — capable enough for the coarse
# presence/structure questions the verdict schema allows, and nothing more is
# needed because the schema forbids the precise-value questions VLMs fail at.
# AI_GRADER_MODEL=claude-sonnet-5

# Output cap for one structured verdict, and how many queued grades one worker
# pass drains.
# AI_GRADER_MAX_TOKENS=2048
# AI_GRADER_BATCH_SIZE=5
