# Root .env — read automatically by `docker compose` (the local daily driver).
# Copy to `.env` and fill in. `.env` is gitignored; this file must never carry a
# real value.
#
# These are the SAME credentials the existing `neurospect-learn-db` container was
# created with. They are kept out of docker-compose.yml so no password — even a
# throwaway local one — is committed.
#
# Note this is a DIFFERENT file from api/.env (the backend's own settings) and
# app/.env (Vite's). Compose only reads this one.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=neurospect_learn

# Any long random string. Changing it invalidates existing logins and any
# outstanding evidence read-tokens; it does not touch stored data.
JWT_SECRET=
