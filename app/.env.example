VITE_API_URL=http://localhost:8000
VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_DEBUG=true

# Deployed (Cloudflare Pages) values, for reference — set these as Production
# environment variables in the Pages project, not here:
#   VITE_API_URL=https://neurospect-learn-api.onrender.com
#   VITE_DISCORD_CLIENT_ID=<the Discord application's client id>
#   VITE_DISCORD_REDIRECT_URI=https://<project>.pages.dev/auth/callback
#   VITE_DEBUG=false
#
# VITE_DEBUG=false matters: the debug-login button it gates is backed by
# POST /auth/debug/token, which the API 404s whenever DEBUG=false. Shipping it
# true would render a button that can only ever fail.
#
# The redirect URI must ALSO be registered in the Discord Developer Portal
# (OAuth2 → Redirects) — Discord rejects any redirect_uri it has not been told
# about, and the error surfaces on Discord's page rather than in this app.
